# The canonical origin used for canonical URLs, Open Graph and the sitemap.
# Set this in Netlify to your production domain, without a trailing slash.
SITE_URL=https://sutra-agent.netlify.app

# Privacy-friendly analytics. Both values are optional; the analytics script is
# not loaded unless PUBLIC_PLAUSIBLE_DOMAIN is set.
PUBLIC_PLAUSIBLE_DOMAIN=
# Use this for a self-hosted Plausible instance. Defaults to https://plausible.io/js/script.js
PUBLIC_PLAUSIBLE_SCRIPT_URL=
