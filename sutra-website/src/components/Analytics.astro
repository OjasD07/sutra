---
const domain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN as string | undefined;
const scriptUrl =
  (import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_URL as string | undefined) ||
  'https://plausible.io/js/script.js';
---

{domain && (
  <script is:inline defer data-domain={domain} src={scriptUrl}></script>
  <script is:inline>
    window.plausible =
      window.plausible ||
      function () {
        (window.plausible.q = window.plausible.q || []).push(arguments);
      };
  </script>
)}
