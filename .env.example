# Sutra reads these from the process environment. It deliberately does NOT
# auto-load a .env file from the workspace (a hostile repository could
# otherwise redirect your API key to another server). To use this file:
#   cp .env.example .env && set -a && . ./.env && set +a
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash | deepseek-v4-pro (see https://api-docs.deepseek.com/quick_start/pricing)
DEEPSEEK_MODEL=deepseek-flash
