---
import Icon from './Icon.astro';
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Switch to light theme"
  title="Switch theme"
>
  <Icon name="sun" size={17} class="theme-icon theme-icon-sun" />
  <Icon name="moon" size={17} class="theme-icon theme-icon-moon" />
</button>
