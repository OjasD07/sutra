---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site';
---

<BaseLayout
  title="Page not found"
  description="This thread does not lead anywhere. Return to the Sutra home page or the repository."
  noindex
  bodyClass="page-simple"
>
  <section class="not-found">
    <div class="container not-found-inner">
      <p class="eyebrow">404</p>
      <h1>This thread doesn’t lead anywhere.</h1>
      <p class="lede">
        The page may have moved. Sutra itself is still on GitHub, where the code and the
        README live.
      </p>
      <div class="not-found-actions">
        <a class="btn btn-primary" href="/">
          <Icon name="arrow-right" size={17} />
          Back to Sutra
        </a>
        <a
          class="btn btn-ghost"
          href={SITE.repo}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="github" size={17} />
          Open GitHub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
