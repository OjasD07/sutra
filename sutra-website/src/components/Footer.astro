---
import { SITE } from '../lib/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();

const explore = [
  { href: '/#why-sutra', label: 'Why Sutra' },
  { href: '/#see-it-work', label: 'See it work' },
  { href: '/#benchmarks', label: 'Benchmarks' },
  { href: '/#quick-start', label: 'Install' },
];

const documentation = [
  { href: SITE.readme, label: 'README' },
  { href: `${SITE.repo}/blob/main/docs/configuration.md`, label: 'Configuration' },
  { href: `${SITE.repo}/blob/main/docs/security.md`, label: 'Security model' },
  { href: `${SITE.repo}/blob/main/docs/quality-engine.md`, label: 'Quality engine' },
  { href: `${SITE.repo}/blob/main/docs/benchmarks.md`, label: 'Benchmarks' },
];

const project = [
  { href: SITE.repo, label: 'GitHub' },
  { href: SITE.contributing, label: 'Contributing' },
  { href: SITE.issues, label: 'Issues' },
  { href: SITE.license, label: 'License' },
  { href: '/privacy/', label: 'Privacy' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand-link" href="/" aria-label="Sutra home">
        <Logo />
      </a>
      <p class="footer-tagline">The thread that connects intelligence to action.</p>
      <p class="footer-copy">
        An open-source AI coding agent for your terminal. See every action, stay in charge,
        and know what it costs.
      </p>
      <p class="footer-status">
        <span class="status-dot" aria-hidden="true"></span>
        Early preview · v{SITE.version} · Apache 2.0
      </p>
    </div>

    <nav class="footer-column" aria-label="Explore">
      <h2>Explore</h2>
      {explore.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <nav class="footer-column" aria-label="Documentation">
      <h2>Documentation</h2>
      {documentation.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer">
          {link.label}
          <Icon name="external" size={12} />
        </a>
      ))}
    </nav>

    <nav class="footer-column" aria-label="Project">
      <h2>Project</h2>
      {project.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith('http') ? '_blank' : undefined}
          rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          {link.label}
          {link.href.startsWith('http') && <Icon name="external" size={12} />}
        </a>
      ))}
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>© {year} Sutra contributors. Released under the Apache License 2.0.</p>
    <p class="footer-mantra"><span lang="sa">सूत्र</span> · the thread that connects intelligence to action.</p>
  </div>
</footer>
