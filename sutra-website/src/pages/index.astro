---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Icon from '../components/Icon.astro';
import SessionCard from '../components/SessionCard.astro';
import TerminalDemo from '../components/TerminalDemo.astro';
import { PROVIDERS, SITE } from '../lib/site';

const features = [
  {
    icon: 'eye',
    title: 'See every action',
    body: 'Reads, edits, commands and test runs appear on one thread as they happen. Every session is saved locally and can be replayed or exported as an audit report.',
    href: `${SITE.repo}#audit-and-replay`,
    link: 'Audit and replay',
  },
  {
    icon: 'shield-check',
    title: 'Stay in charge',
    body: 'Three permission profiles, plus an OS sandbox on macOS and Linux. Repository content can describe conventions, but it cannot loosen the rules.',
    href: `${SITE.repo}#staying-in-control`,
    link: 'Permissions and sandbox',
  },
  {
    icon: 'coins',
    title: 'Know what it costs',
    body: 'Token usage, cache hits and estimated spend are tracked per request. A budget can pause the agent before it overspends, and local models report $0.',
    href: `${SITE.repo}#cost-and-budgets`,
    link: 'Cost and budgets',
  },
  {
    icon: 'check-circle',
    title: 'Verified, not just finished',
    body: 'A harness-owned finish gate checks each acceptance criterion against evidence recorded after the last edit, and marks what it cannot prove as unverified.',
    href: `${SITE.repo}/blob/main/docs/quality-engine.md`,
    link: 'How verification works',
  },
  {
    icon: 'plug',
    title: 'Bring your own model',
    body: 'DeepSeek is the tuned default. Use OpenRouter, OpenAI, Anthropic, Gemini or a local model through Ollama and friends. One workflow, any provider.',
    href: `${SITE.repo}/blob/main/docs/configuration.md#providers`,
    link: 'Every provider',
  },
  {
    icon: 'git-branch',
    title: 'Built for real repositories',
    body: 'A fast local index, symbol lookup and ranked code search help Sutra find the right code before it edits, with context kept small enough to be useful.',
    href: `${SITE.repo}#codebase-understanding`,
    link: 'Codebase understanding',
  },
];

const steps = [
  {
    icon: 'file-code',
    title: 'Read',
    body: 'Index the repository, read the likely files, and find symbols, callers and the tests that mention them.',
  },
  {
    icon: 'route',
    title: 'Plan',
    body: 'Plan mode investigates read-only and records each step. Nothing changes until you approve the plan.',
  },
  {
    icon: 'terminal',
    title: 'Act',
    body: 'Edits are previewed as diffs and written atomically. Commands run one at a time, inside the OS sandbox.',
  },
  {
    icon: 'shield-check',
    title: 'Verify',
    body: 'Run your test command, then check each acceptance criterion against evidence recorded after the last edit.',
  },
  {
    icon: 'layers',
    title: 'Record',
    body: 'Save the session locally. Replay it as a timeline, or export a Markdown or JSON audit report.',
  },
];

const benchmarkRows = [
  { harness: 'Sutra (fast)', passed: '12/12', time: '9.4 s', cost: '$0.0015', tokens: '29,181', sutra: true },
  { harness: 'OpenCode', passed: '12/12', time: '10.6 s', cost: '$0.0018', tokens: '47,430', sutra: false },
  { harness: 'Goose', passed: '12/12', time: '10.9 s', cost: '$0.0019', tokens: '33,408', sutra: false },
  { harness: 'Claude Code', passed: '12/12', time: '10.8 s', cost: '$0.0030', tokens: '76,353', sutra: false },
  { harness: 'Sutra (balanced)', passed: '12/12', time: '12.8 s', cost: '$0.0030', tokens: '41,024', sutra: true },
  { harness: 'Qwen Code', passed: '12/12', time: '17.4 s', cost: '$0.0044', tokens: '95,495', sutra: false },
];

const faqs = [
  {
    question: 'Is Sutra free and open source?',
    answer:
      'Yes. Sutra is released under the Apache License 2.0, including an explicit patent grant from contributors. You pay only your model provider when you use a cloud model. Local models are free.',
  },
  {
    question: 'Which models and providers can I use?',
    answer:
      'DeepSeek is the tuned default. Sutra also works with OpenRouter, OpenAI, Anthropic, Google Gemini, xAI, Mistral, Groq, Cerebras, Together, Fireworks, DeepInfra, Moonshot, Z.AI, Qwen, SambaNova, Hugging Face, Vercel AI Gateway, any OpenAI-compatible server, and local models through Ollama, LM Studio, llama.cpp, vLLM and Jan.',
  },
  {
    question: 'Does Sutra send my code anywhere?',
    answer:
      'The CLI sends the content the agent reads to the model provider you configure. With a local model, inference stays on your machine. Sutra stores sessions locally in SQLite and never pushes, publishes or deploys on its own. The security model explains exactly what is enforced.',
  },
  {
    question: 'What does the OS sandbox actually prevent?',
    answer:
      'Commands run under your user account inside a sandbox. Writes are limited to the workspace, temp directories and package-manager caches; credential stores are hidden; outbound network traffic is blocked unless you approved that command as a network command. It is a strong second layer, not a virtual machine.',
  },
  {
    question: 'Does Sutra work on Windows?',
    answer:
      'Not yet. macOS is the primary platform. Linux is supported, but the bubblewrap backend has not been tested on Linux yet. There is no Windows backend.',
  },
  {
    question: 'How is Sutra different from other coding agents?',
    answer:
      'The harness owns the rules. Permissions and the sandbox cannot be changed by repository content, every action is recorded and replayable, and a finish gate refuses to call work done when the evidence is missing.',
  },
  {
    question: 'Are the benchmark numbers guarantees?',
    answer:
      'No. The bundled suite is four small tasks. It measures whether a model handles Sutra’s tool loop reliably and roughly what each solved task costs; it is not a leaderboard of general coding ability. A harder held-out suite is on the roadmap.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: `${SITE.url}/`,
    description: SITE.description,
    inLanguage: 'en',
    publisher: {
      '@type': 'Organization',
      name: 'Sutra contributors',
      url: SITE.repo,
      logo: `${SITE.url}/brand/github-avatar.png`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Sutra',
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'AI coding agent',
    operatingSystem: 'macOS, Linux',
    description: SITE.description,
    url: `${SITE.url}/`,
    downloadUrl: `${SITE.repo}#quick-start`,
    codeRepository: SITE.repo,
    license: 'https://www.apache.org/licenses/LICENSE-2.0',
    softwareVersion: SITE.version,
    isAccessibleForFree: true,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    author: {
      '@type': 'Organization',
      name: 'Sutra contributors',
      url: SITE.repo,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout jsonLd={structuredData} bodyClass="home">
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow reveal">
          <span class="status-dot" aria-hidden="true"></span>
          Open source · Apache 2.0 · early preview
        </p>
        <h1 class="reveal">
          The thread that connects
          <span class="text-gold">intelligence</span>
          to
          <span class="text-green">action</span>.
        </h1>
        <p class="lede reveal">
          Sutra is an open-source AI coding agent for your terminal. It reads your code,
          makes the change, runs your tests, and tells you exactly what it did.
        </p>
        <div class="hero-actions reveal">
          <a
            class="btn btn-primary btn-lg"
            href={`${SITE.repo}#quick-start`}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics="download-hero"
          >
            <Icon name="github" size={19} />
            Download on GitHub
          </a>
          <a class="btn btn-ghost btn-lg" href="#see-it-work">
            See it work
            <Icon name="arrow-right" size={17} />
          </a>
        </div>
        <p class="hero-meta reveal">
          Node.js 22.13+ · macOS and Linux · DeepSeek, OpenRouter, OpenAI, Anthropic,
          Gemini, local models and 20+ providers.
        </p>
      </div>

      <div class="hero-visual reveal">
        <SessionCard />
      </div>
    </div>

    <div class="container hero-stats reveal">
      <div class="stat">
        <strong>24</strong>
        <span>providers and local runtimes</span>
      </div>
      <div class="stat">
        <strong>3</strong>
        <span>permission profiles</span>
      </div>
      <div class="stat">
        <strong>2</strong>
        <span>layers of command safety</span>
      </div>
      <div class="stat">
        <strong>1</strong>
        <span>thread from request to verified result</span>
      </div>
    </div>
  </section>

  <section class="section section-features" id="why-sutra">
    <div class="container">
      <div class="section-heading reveal">
        <p class="eyebrow">Why Sutra</p>
        <h2>A coding agent you can watch.</h2>
        <p>
          Most agents ask you to trust the result. Sutra shows the work: every read,
          edit, command and test on one thread, with the permissions, evidence and cost
          attached.
        </p>
      </div>

      <div class="feature-grid">
        {features.map((feature, index) => (
          <article
            class="feature-card reveal"
            style={`--delay: ${index * 55}ms`}
          >
            <span class="feature-icon" aria-hidden="true">
              <Icon name={feature.icon} size={21} />
            </span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
            <a
              class="text-link"
              href={feature.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {feature.link}
              <Icon name="arrow-right" size={14} />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-terminal" id="see-it-work">
    <div class="container">
      <div class="section-heading reveal">
        <p class="eyebrow">A real example</p>
        <h2>Find the bug. Fix it. Prove it.</h2>
        <p>
          This is the bundled <code>session-expiry</code> example: a timestamp in seconds
          is compared with one in milliseconds, so every session looks expired. Sutra
          reads, edits, re-runs the tests and reports exactly what changed.
        </p>
      </div>

      <TerminalDemo />

      <div class="terminal-notes reveal">
        <div class="note">
          <Icon name="lock" size={18} />
          <p><strong>Approvals are part of the loop.</strong> The edit waits for you. The diff is shown before anything changes.</p>
        </div>
        <div class="note">
          <Icon name="check-circle" size={18} />
          <p><strong>The result is evidence.</strong> Test counts come from the runner. Tokens and cost come from the provider's reported usage.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-thread" id="how-it-works">
    <div class="container">
      <div class="section-heading reveal">
        <p class="eyebrow">How it works</p>
        <h2>One loop, from question to evidence.</h2>
        <p>
          Sutra repeats a simple loop until the task is done, you stop it, or a limit is
          reached. Every turn ends in an explicit state: completed, failed, cancelled or
          over budget.
        </p>
      </div>

      <ol class="thread-steps">
        {steps.map((step, index) => (
          <li class="thread-step reveal" style={`--delay: ${index * 70}ms`}>
            <span class="thread-step-icon" aria-hidden="true">
              <Icon name={step.icon} size={20} />
            </span>
            <span class="thread-step-number">0{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>

      <p class="thread-note reveal">
        Commands run inside the OS sandbox. Edits are approval-gated. Nothing is left
        half-recorded.
      </p>
    </div>
  </section>

  <section class="section section-verification" id="verification">
    <div class="container split">
      <div class="section-heading reveal">
        <p class="eyebrow">Verification</p>
        <h2>Done should mean proven.</h2>
        <p>
          When the model stops calling tools, Sutra’s finish gate checks each acceptance
          criterion against checks recorded <em>after</em> the last edit. If the evidence
          is not there, the result is marked unverified — not done.
        </p>
        <ul class="check-list">
          <li><Icon name="check-circle" size={16} /> Evidence, not the model’s confidence</li>
          <li><Icon name="check-circle" size={16} /> Counterexamples are re-run by the harness</li>
          <li><Icon name="check-circle" size={16} /> Reviews can raise gaps, never pass a criterion</li>
        </ul>
        <a
          class="text-link"
          href={`${SITE.repo}/blob/main/docs/quality-engine.md`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read the quality engine docs
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <figure class="evidence-card reveal">
        <div class="evidence-head">
          <span class="evidence-status">
            <span class="status-dot status-dot-green" aria-hidden="true"></span>
            verified
          </span>
          <span class="evidence-meta">balanced mode · sent back 1×</span>
        </div>

        <div class="evidence-list">
          <div class="evidence-row">
            <Icon name="check-circle" size={16} class="evidence-icon" />
            <div>
              <strong>The session tests pass</strong>
              <code>npm test → exit 0 (4/4 passed)</code>
            </div>
          </div>
          <div class="evidence-row">
            <Icon name="check-circle" size={16} class="evidence-icon" />
            <div>
              <strong>No test files are modified</strong>
              <code>changed src/session.js; no test files changed</code>
            </div>
          </div>
          <div class="evidence-row">
            <Icon name="check-circle" size={16} class="evidence-icon" />
            <div>
              <strong>Expired once the expiry time is reached</strong>
              <code>provisional test “expiry boundary” passes</code>
            </div>
          </div>
        </div>

        <div class="evidence-review">
          <span>Review</span>
          <p>aligned — “Makes isExpired compare expiresAt in seconds against now in milliseconds.”</p>
        </div>

        <div class="evidence-foot">1 provisional test · 0 still failing</div>
        <figcaption>Layout of the evidence table; the rows are illustrative.</figcaption>
      </figure>
    </div>

    <div class="container">
      <div class="quality-modes reveal">
        <div class="mode">
          <span class="mode-name mono">fast</span>
          <p>Evidence labels only. No extra model calls.</p>
          <span class="mode-cost">no extra cost</span>
        </div>
        <div class="mode mode-featured">
          <span class="mode-name mono">balanced</span>
          <p>Packet, baseline, contract, finish gate and review. Counterexamples only when a criterion lacks evidence.</p>
          <span class="mode-cost">+32% on bundled tasks</span>
        </div>
        <div class="mode">
          <span class="mode-name mono">deep</span>
          <p>A second probe round, plus competing patches when a fix still fails.</p>
          <span class="mode-cost">several times more</span>
        </div>
      </div>

      <p class="measured-note reveal">
        On the four bundled tasks with live DeepSeek (5 November 2026),
        <strong>balanced solved 4/4</strong>, the gate said <strong>verified on exactly
        those 4</strong>, for <strong>$0.0074</strong> in 59 s. The tasks are small; read
        the limits in the docs.
      </p>
    </div>
  </section>

  <section class="section section-benchmarks" id="benchmarks">
    <div class="container">
      <div class="section-heading reveal">
        <p class="eyebrow">Benchmarks</p>
        <h2>Measure the setup you actually run.</h2>
        <p>
          <code>sutra bench</code> copies each task into a fresh repository, runs one
          agent turn with the Flow profile in the sandbox, restores the original tests,
          and judges only by the test command’s exit code.
        </p>
      </div>

      <div class="benchmark-meta reveal">
        <span>First harness comparison</span>
        <span>5 November 2026</span>
        <span>deepseek-flash</span>
        <span>4 tasks × 3 trials</span>
      </div>

      <div class="table-wrap reveal">
        <table class="benchmark-table">
          <caption class="sr-only">
            Harness comparison on four bundled tasks, three trials each, using
            deepseek-flash. Sutra (fast) passed 12 of 12 in a median 9.4 seconds at
            $0.0015 per solved task.
          </caption>
          <thead>
            <tr>
              <th scope="col">Harness</th>
              <th scope="col">Passed</th>
              <th scope="col">Median time</th>
              <th scope="col">Cost / solved task</th>
              <th scope="col">Input tokens / run</th>
            </tr>
          </thead>
          <tbody>
            {benchmarkRows.map((row) => (
              <tr class:list={{ 'is-sutra': row.sutra }}>
                <th scope="row">{row.harness}</th>
                <td>{row.passed}</td>
                <td>{row.time}</td>
                <td>{row.cost}</td>
                <td>{row.tokens}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="table-note reveal">
        Every harness that reached the model solved every task. These small tasks
        separate cost, speed and tokens, not general accuracy.
        <a
          href={`${SITE.repo}/blob/main/docs/benchmarks.md`}
          target="_blank"
          rel="noopener noreferrer"
        >Read the benchmark docs <Icon name="arrow-right" size={13} /></a>
      </p>
    </div>
  </section>

  <section class="section section-providers" id="providers">
    <div class="container">
      <div class="section-heading center reveal">
        <p class="eyebrow">Model independent</p>
        <h2>Bring your own model.</h2>
        <p>
          Use a cloud provider with one key, or keep code on your machine with a local
          model. <code>sutra init</code> checks that the model can call tools before you
          start.
        </p>
      </div>

      <div class="provider-groups">
        <div class="provider-group reveal">
          <h3>Cloud providers</h3>
          <ul class="pill-list">
            {PROVIDERS.cloud.map((provider) => <li>{provider}</li>)}
          </ul>
        </div>
        <div class="provider-group reveal">
          <h3>On this machine · no key, private</h3>
          <ul class="pill-list pill-list-local">
            {PROVIDERS.local.map((provider) => <li>{provider}</li>)}
            <li>{PROVIDERS.other}</li>
          </ul>
        </div>
      </div>

      <p class="providers-note reveal">
        DeepSeek is the tuned default.
        <a
          href={`${SITE.repo}/blob/main/docs/configuration.md#providers`}
          target="_blank"
          rel="noopener noreferrer"
        >See every provider and endpoint <Icon name="arrow-right" size={13} /></a>
      </p>
    </div>
  </section>

  <section class="section section-quickstart" id="quick-start">
    <div class="container split quickstart-grid">
      <div class="section-heading reveal">
        <p class="eyebrow">Quick start</p>
        <h2>Start with a task, not a config file.</h2>
        <p>
          You need Node.js 22.13 or newer on macOS or Linux. <code>ripgrep</code> is
          optional and makes search faster.
        </p>

        <div class="quickstart-notes">
          <p><strong>A first run is safe.</strong> Sutra asks before it changes a file or runs a command.</p>
          <p><strong>Bring a key or a local model.</strong> <code>sutra init</code> spots keys already in your environment and local servers that are running.</p>
        </div>

        <a
          class="btn btn-primary"
          href={`${SITE.repo}#quick-start`}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="download-quickstart"
        >
          <Icon name="github" size={18} />
          Get Sutra on GitHub
        </a>
      </div>

      <div class="quickstart-steps reveal">
        <div class="quickstart-step">
          <div class="quickstart-step-head">
            <span class="step-number">1</span>
            <h3>Install</h3>
          </div>
          <CodeBlock
            label="Terminal"
            code={`git clone https://github.com/cneuralnetwork/sutra.git
cd sutra
npm install
npm link`}
          />
        </div>

        <div class="quickstart-step">
          <div class="quickstart-step-head">
            <span class="step-number">2</span>
            <h3>Connect a model</h3>
          </div>
          <CodeBlock label="Terminal" code="sutra init" />
        </div>

        <div class="quickstart-step">
          <div class="quickstart-step-head">
            <span class="step-number">3</span>
            <h3>Give it a task</h3>
          </div>
          <CodeBlock
            label="Terminal"
            code={`cd your-project
sutra "explain how this repository is organised"`}
          />
        </div>

        <div class="example-tip">
          <Icon name="play" size={16} />
          <p>
            Want a real bug to watch? Run <code>npm test</code> inside
            <code>examples/session-expiry</code>, then ask Sutra to fix the failing
            session tests.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-faq" id="faq">
    <div class="container faq-container">
      <div class="section-heading center reveal">
        <p class="eyebrow">Questions</p>
        <h2>What to know before you start.</h2>
        <p>
          Sutra is an early preview. These are the answers that matter most before you
          point it at a repository.
        </p>
      </div>

      <div class="faq-list reveal">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>
              <span>{faq.question}</span>
              <span class="faq-plus" aria-hidden="true">+</span>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-cta">
    <div class="container">
      <div class="cta-panel reveal">
        <div class="cta-thread" aria-hidden="true"></div>
        <p class="eyebrow">Open source · Apache 2.0</p>
        <h2>Read the code. Run the tests. See for yourself.</h2>
        <p>
          Sutra is in early preview. The core is complete and covered by tests, and the
          roadmap is public.
        </p>
        <div class="cta-actions">
          <a
            class="btn btn-primary btn-lg"
            href={SITE.repo}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics="download-cta"
          >
            <Icon name="github" size={19} />
            Get Sutra on GitHub
          </a>
          <a
            class="btn btn-ghost btn-lg"
            href={SITE.readme}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics="readme-cta"
          >
            <Icon name="book-open" size={18} />
            Read the README
          </a>
        </div>
        <p class="cta-note">
          <a
            href={`${SITE.repo}#roadmap`}
            target="_blank"
            rel="noopener noreferrer"
          >View the roadmap <Icon name="arrow-right" size={13} /></a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
