---
import Icon from './Icon.astro';

interface Props {
  code: string;
  label?: string;
  language?: string;
}

const { code, label = 'Terminal', language = 'bash' } = Astro.props;
---

<div class="code-block">
  <div class="code-head">
    <span class="code-label">
      <span class="code-dot" aria-hidden="true"></span>
      {label}
    </span>
    <button class="copy-button" type="button" data-copy aria-label="Copy code">
      <Icon name="copy" size={13} />
      <span data-copy-label aria-live="polite">Copy</span>
    </button>
  </div>
  <pre tabindex="0"><code class={`language-${language}`}>{code}</code></pre>
</div>
